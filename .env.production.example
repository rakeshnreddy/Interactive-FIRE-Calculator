# Copy this file to .env.production.local after the Clerk production instance is active.
# Vite loads .env.production.local during `vite build`; the file is gitignored.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_replace_me
# Used for production auth preflight and automatically rewrites canonical, OG, sitemap, robots, and llms.txt URLs.
FINPATH_PRODUCTION_ORIGIN=https://app.example.com
# Optional: override the quiet footer "Send feedback" link (https:// or mailto:).
# VITE_FEEDBACK_URL=https://app.example.com/feedback
